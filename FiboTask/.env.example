DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local default is SQLite. For Postgres set e.g.:
# DATABASE_URL=postgres://postgres:1010@localhost:5432/todo_db
DATABASE_URL=
FIBONACCI_MAX_TERMS=1000
