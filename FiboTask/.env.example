# NEVER commit real secrets. Copy to `.env` for local dev.
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local default is SQLite. For Postgres set e.g.:
# DATABASE_URL=postgres://postgres:1010@localhost:5432/todo_db
DATABASE_URL=
FIBONACCI_MAX_TERMS=1000
# Google sign-in (optional until credentials exist; button hides itself without them).
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
